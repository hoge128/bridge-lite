    "about.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For photographers who shoot RAW+JPG simultaneously.\nGroups matching pairs, filters by rating and file type,\nand previews EXIF data — all at native macOS speed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RAW+JPG 同時撮影をしているフォトグラファーへ。\nペアを自動でグループ化し、\n評価やファイル種別でフィルタリング、EXIF をすばやく確認できます。"
          }
        }
      }
    },

        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォルダはネットワークボリューム上にあります。スキャンに時間がかかり、接続が不安定な場合は失敗することがあります。"
          }
        }
      }
    },

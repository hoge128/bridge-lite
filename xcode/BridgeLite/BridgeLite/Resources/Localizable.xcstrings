    "settings.grouping.split_threshold" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Split threshold"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分割しきい値"
          }
        }
      }
    },
    "settings.grouping.split_threshold.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same-name files (e.g. IMG_0001.CR3 + IMG_0001.JPG) are grouped together when their EXIF timestamps differ by no more than this value. Files exceeding the limit are split as same-name collisions from different cameras. Increase to tolerate larger clock offsets between RAW and JPEG; decrease to split more aggressively."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同名ファイル（例: IMG_0001.CR3 + IMG_0001.JPG）の EXIF 撮影日時の差がこの秒数以内なら同一グループにまとめます。超えた場合は別カメラからの同名衝突と判定して別グループに分割します。大きくすると RAW・JPEG 間の時刻ズレを許容し、小さくするとより厳しく分割します。"
          }
        }
      }
    },
    "settings.grouping.split_threshold.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Same-name files with EXIF timestamps more than this many seconds apart are treated as separate cameras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同名ファイルの EXIF 撮影日時の差がこの秒数を超えると、別カメラと判定して別グループにします。"
          }
        }
      }
    },
    "settings.metadata.conflict_policy" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When embedded XMP exists"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "埋め込み XMP がある場合"
          }
        }
      }
    },
    "settings.metadata.conflict_policy.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controls what happens when a JPEG already has ratings or labels embedded directly and you rate it in Sidecar mode.\n**Ask each time**: shows a confirmation listing the affected filenames.\n**Always propagate**: silently updates both sidecar and embedded.\n**Never propagate**: writes only to the sidecar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイドカーモードで評価した際、JPEG ファイルに既存の評価・ラベルが埋め込まれている場合の動作を選びます。\n**毎回確認する**: 対象ファイル名を列挙して確認ダイアログを表示します。\n**常に伝搬する**: サイドカーと埋め込みの両方を自動で更新します。\n**伝搬しない**: サイドカーのみに書き込みます。"
          }
        }
      }
    },
    "settings.metadata.help.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Embed** — Rating is written directly into the JPEG file. The file is self-contained and portable, but the original is modified.\n\n**Sidecar** — Rating is saved as a separate `.xmp` file next to the image. The original is never modified, but you must copy the `.xmp` alongside the image when transferring to other software (Lightroom, Capture One, etc.).\n\nRAW files always use a sidecar regardless of this setting.\n\n**Note:** In Sidecar mode, a JPEG and its paired RAW share the same `.xmp` file (e.g. `IMG_0001.xmp`). Rating one automatically updates the other."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**埋め込み** — 評価を JPEG ファイルに直接書き込みます。ファイル単体で持ち運べますが、元ファイルが変更されます。\n\n**サイドカー** — 評価を隣に `.xmp` ファイルとして保存します。元ファイルは変更されませんが、Lightroom・Capture One 等へ持ち出す際は `.xmp` も一緒にコピーする必要があります。\n\nRAW ファイルはこの設定に関わらず常にサイドカーが使われます。\n\n**注意:** サイドカーモードでは、JPEG と同名の RAW は同じ `.xmp` ファイルを共有します（例: `IMG_0001.xmp`）。一方を評価するともう一方にも自動的に反映されます。"
          }
        }
      }
    },
    "settings.metadata.jpg_write_mode" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JPEG Metadata"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JPEG メタデータ書き込み"
          }
        }
      }
    },
    "settings.metadata.jpg_write_mode.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Embed**: writes XMP directly into the JPEG file.\n**Sidecar**: creates a separate .xmp file and leaves the JPEG unchanged."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**埋め込み**: XMP を JPEG ファイルに直接書き込みます。\n**サイドカー**: 隣に .xmp ファイルを作成し、JPEG 本体は変更しません。"
          }
        }
      }
    },

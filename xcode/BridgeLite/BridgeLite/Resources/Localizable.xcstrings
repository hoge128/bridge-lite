    "alert.slow_storage.message.hdd" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected folder is on a rotational hard disk. Scanning may take significantly longer than on an SSD, and overall app performance may be reduced. For best results, copy the photos to internal SSD storage first."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォルダはハードディスク（HDD）上にあります。SSD と比べてスキャンに大幅に時間がかかり、動作も遅くなる可能性があります。可能であれば、内蔵 SSD に写真をコピーしてから開くことを推奨します。"
          }
        }
      }
    },
    "alert.slow_storage.message.network" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected folder is on a network volume. Scanning will be slow and unreliable on unstable connections."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したフォルダはネットワークボリューム上にあります。スキャンに時間がかかり、接続が不安定な場合は失敗することがあります。"
          }
        }
      }
    },

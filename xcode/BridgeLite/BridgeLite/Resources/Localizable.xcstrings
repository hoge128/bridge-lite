        }
      }
    },
    "settings.grouping.phash_threshold" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pHash threshold"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "pHash しきい値"
          }
        }
      }
    },
    "settings.grouping.phash_threshold.description" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rescues EXIF-stripped files (e.g. DxO / Lightroom exports) into a matching group using visual similarity (perceptual hash Hamming distance). Same-image cross-format conversions typically score ≤ 14; unrelated images typically score ≥ 20. Increase to widen the rescue net; decrease for stricter matching."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EXIF 撮影日時が欠損したファイル（DxO・Lightroom 等の書き出しに多い）を、視覚的な類似度（知覚ハッシュのハミング距離）で確定グループへ救済するときの距離の上限です。同一画像の異フォーマット変換は距離 ≤ 14、無関係な画像は距離 ≥ 20 が目安です。大きくすると救済範囲が広がり、小さくすると厳格になります。"
          }
        }
      }
    },
    "settings.grouping.phash_threshold.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hamming distance limit for rescuing EXIF-stripped files (IAD) into a confirmed group. Lower = stricter matching."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EXIF 欠損ファイル (IAD) を確定グループに救済するための Hamming 距離の上限。小さいほど厳格な一致が必要になります。"
          }
        }
      }
    },
    "settings.grouping.regroup_button" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-group"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再グループ化"
          }
        }
      }
    },
    "settings.grouping.regroup_button.help" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-apply grouping logic with the current thresholds without re-scanning thumbnails or EXIF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サムネイルや EXIF を再スキャンせず、現在のしきい値でグルーピングを再適用します。"
          }
        }
      }
    },
    "settings.grouping.reset_button" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
